{
    "name": "peterujah/nano-image",
    "type": "library",
    "description": "A lightweight PHP image manipulation library powered by GD.",
    "keywords": [
        "php",
        "image",
        "image-manipulation",
        "image-processing",
        "resize",
        "crop",
        "rotate",
        "filters",
        "gd"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Ujah Chigozie",
            "email": "ujahchigozie@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-gd": "*"
    },
    "suggest": {
        "ext-exif": "Required for reading source image EXIF metadata."
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Peterujah\\Media\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Peterujah\\Media\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
